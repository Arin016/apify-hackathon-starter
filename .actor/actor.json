{
  "actorSpecification": 1,
  "name": "workflow-composer",
  "title": "Actor Fit \u2014 Workflow Optimization",
  "description": "Compare complete Apify workflows on the same inputs and output requirements. Inspect measured costs and quality checks, then export a tested winner as a reusable Actor.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "Workflow comparison",
    "properties": {
      "result": {
        "type": "string",
        "title": "Comparison result and measured costs",
        "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/OUTPUT"
      },
      "report": {
        "type": "string",
        "title": "Open graphical workflow comparison",
        "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/REPORT.html"
      },
      "project": {
        "type": "string",
        "title": "Download generated Actor project",
        "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/ACTOR_PROJECT.zip"
      },
      "deployment": {
        "type": "string",
        "title": "Created Actor and test receipt",
        "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/DEPLOYMENT"
      }
    }
  }
}
